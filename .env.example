# ─────────────────────────────────────────────────────────────
# SAMVAD — Environment Configuration
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Application
ENVIRONMENT=development
DEBUG=false

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Speech-to-Text
STT_PROVIDER=sarvam
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# LLM
LLM_API_KEY=
LLM_MODEL=

# Embeddings
EMBEDDING_MODEL=

# Vector Database
VECTOR_DB_PATH=./data/vector_index

# Dataset
DATASET_CACHE_DIR=./data/datasets

# Retrieval
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5

# Pipeline
PIPELINE_TIMEOUT_SECONDS=30.0
STAGE_TIMEOUT_SECONDS=10.0
MAX_RETRIES=2

# Logging
LOG_LEVEL=INFO
