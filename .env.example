# ─────────────────────────────────────────────────────────────
# SAMVAD — Environment Configuration
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Application
ENVIRONMENT=development
DEBUG=false

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Speech-to-Text
STT_PROVIDER=sarvam
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# LLM (supported providers: openai, ollama, gemini)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embeddings (local_tfidf_svd works offline with zero keys; or set openai_compatible)
EMBEDDING_PROVIDER=local_tfidf_svd
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Storage & Vector Database
SQLITE_DB_PATH=./data/samvad.db
VECTOR_DB_PATH=./data/vector_index
MAX_DOCUMENT_UPLOAD_BYTES=10485760

# Dataset
DATASET_CACHE_DIR=./data/datasets

# Retrieval
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5

# Pipeline
PIPELINE_TIMEOUT_SECONDS=30.0
STAGE_TIMEOUT_SECONDS=10.0
MAX_RETRIES=2
MAX_AUDIO_UPLOAD_BYTES=10485760

# Logging
LOG_LEVEL=INFO
